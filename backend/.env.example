# development | production
ENVIRONMENT=development

# SQLAlchemy URL. Relative sqlite paths resolve from the backend/ directory.
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# Optional regex for additional allowed origins (e.g. Vercel preview deployments).
# CORS_ORIGIN_REGEX=https://octeveaiint-.*\.vercel\.app

# Gemini API key from https://aistudio.google.com/apikey. Leave empty to run without AI
# (questions come from the bundled bank and feedback is rule-based).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Per-request timeout for Gemini calls, in seconds.
AI_TIMEOUT_SECONDS=30
